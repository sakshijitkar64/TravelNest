<!-- SEARCH -->

<div class="container tn-search-container col-8" id="travelSearch">

   <form class="tn-search" action="/listings" method="GET">

    <div class="tn-search-item">
        <small>Where</small>
        <input
            type="text"
            name="location"
            placeholder="Search destinations"
        >
    </div>

    <div class="tn-search-item">
        <small>When</small>
        <input
            type="text"
            name="date"
            placeholder="Add dates"
        >
    </div>

    <div class="tn-search-item">
        <small>Who</small>
        <input
            type="text"
            name="guests"
            placeholder="Add guests"
            min="1"
        >
    </div>

    <button class="tn-search-btn" type="submit">
        🔍
    </button>

</form>

</div>
<script>
    window.addEventListener("scroll", function () {

        if (window.scrollY > 80) {
            document.body.classList.add("scrolled");
        } else {
            document.body.classList.remove("scrolled");
        }

    });
</script>